PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/niwakati
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
TOKEN_TTL_SECONDS=3600
CLIENT_ACCESS_DAYS=7
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Used once by `npm run seed:admin`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-passphrase
